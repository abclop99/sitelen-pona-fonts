// leko. Imported from the earlier Inkscape drawings; edit freely.
glyph("leko", 0xF197C, #{ width: p.cell });

stroke(path(pt(75, 775))
       .line(pt(825, 775))
       .line(pt(825, 25))
       .line(pt(75, 25))
       .line(pt(75, 775))
       .close());
stroke(path(pt(293.75, 556.25))
       .line(pt(606.25, 556.25))
       .line(pt(606.25, 243.75))
       .line(pt(293.75, 243.75))
       .line(pt(293.75, 556.25))
       .close());
